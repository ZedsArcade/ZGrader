# Copy this file to .env and fill in real values before running
# `docker compose up`. See docs/qa_checklist.md for the full setup walkthrough
# and docs/deployment.md for the Cloudflare Tunnel notes.

# --- Environment ---
# `production` turns on the startup checks that refuse the shipped-default
# secret and database password, and switches off the interactive API docs at
# /api/docs. The backend will not boot in production until the two values
# below are real -- that is deliberate. Use `development` only for local work.
ZGRADER_ENV=production

# --- Postgres ---
POSTGRES_USER=zgrader
# Generate one, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=zgrader
POSTGRES_DATA_PATH=/mnt/user/appdata/zgrader/postgres
REPORTS_DATA_PATH=/mnt/user/appdata/zgrader/reports

# Host-side path the scanner software writes into (SMB/NFS mount point, or a
# local folder). Mounted into both `backend` and `worker` at /data/scans.
# On Unraid this must be writable by uid:gid 99:100 (nobody:users), which is
# what the containers run as -- see backend/Dockerfile's APP_UID/APP_GID.
SCANS_HOST_PATH=/mnt/user/appdata/zgrader/scans

# --- Backend ---
# Generate a real random value: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it later logs everyone out; it signs every session token.
ZGRADER_SECRET_KEY=change-me-to-a-real-random-secret

# Public origin customers reach the site on. Used to build the links inside
# verification and password-reset emails, so a wrong value here produces mail
# with links nobody can open. Include the scheme, no trailing slash.
ZGRADER_SITE_URL=https://cards.example.com

# --- Cloudflare Tunnel (the reference way to publish the site) ---
# Create the tunnel in Cloudflare Zero Trust -> Networks -> Tunnels, choose
# Docker as the environment, and copy the token out of the command it shows
# (the long eyJ... string after --token). Route the tunnel's public hostname
# to http://caddy:80 -- cloudflared runs in this stack, so it reaches Caddy
# over the Docker network with no host port involved.
#
# The cloudflared service starts unconditionally. Without a token it logs the
# missing credential and restarts; if you are not using a tunnel, delete the
# service from docker-compose.yml.
#
# Nothing is port-forwarded at the router, and nothing should be: the backend
# trusts CF-Connecting-IP for rate limiting, so a directly reachable origin
# lets anyone forge it. See docs/deployment.md.
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Admin bootstrap (optional) ---
# Set both to auto-create an operator/admin account on startup (the admin
# panel lives at /admin). If an account with this email already exists as a
# client, it is promoted to operator -- keeping its existing password, because
# a redeploy silently reverting a password you set in the app would be a
# miserable thing to debug. Case doesn't matter; addresses are normalised.
# ZGRADER_ADMIN_EMAIL=you@example.com
# ZGRADER_ADMIN_PASSWORD=<a strong password>

# Locked out? Set this to true and redeploy: the password above is forced onto
# the account and every existing session for it is signed out. Then unset it
# and redeploy again -- while it stays true, anyone who can read this file can
# take the admin account on the next restart.
# ZGRADER_ADMIN_RESET_PASSWORD=false

# --- Optional external AI vision model (off by default) ---
# When enabled, the analysis pipeline also asks an Ollama-compatible vision
# model for extra "AI-assisted" observations. Leave disabled unless you host
# one (e.g. an Ollama container with a llava/qwen2-vl model).
# ZGRADER_AI_ENABLED=false
# ZGRADER_AI_ENDPOINT=http://ollama:11434/api/generate
# ZGRADER_AI_MODEL=llava

# --- SMTP ---
# READ THIS BEFORE GOING LIVE. The defaults below point at the bundled
# `mailhog` dev service, which only runs under the `dev` compose profile -- so
# in a normal production deployment they point at nothing and no mail leaves
# the server at all.
#
# That is not cosmetic. Submitting a card requires a confirmed email address,
# and the only way to confirm one is the link in the verification email. With
# no working relay, a customer can register and then find they cannot submit
# anything, with no way to fix it themselves. Password reset is dead too.
#
# Point these at a real relay before anyone else uses the site.
#
# Don't self-host the outbound side. Delivering mail directly means connecting
# to each recipient's server on port 25, and consumer ISPs filter outbound 25
# nearly universally -- measured from this deployment's network, the TCP
# handshake completes and then no SMTP banner ever arrives, against Google and
# Outlook alike. Consumer IP ranges also sit on Spamhaus' PBL by default and
# rDNS/PTR usually cannot be set, so even an open port 25 lands in spam.
#
# The shape that works, and costs nothing:
#   receiving -> Cloudflare Email Routing, free, forwards you@yourdomain to an
#                inbox you already read. Set the result as contact_email in
#                Admin -> Settings.
#   sending   -> a transactional relay's free tier (Resend, Brevo, MailerSend).
#
# Send from a SUBDOMAIN (e.g. noreply@send.yourdomain). Two reasons: a domain
# may have exactly one SPF record and two is a permanent failure rather than a
# merge, so keeping the relay's SPF on a subdomain stops it colliding with the
# one Cloudflare Email Routing writes to the root; and if the relay's
# reputation ever suffers, the damage is contained to the subdomain.
#
# TLS: the two flags below are alternatives, not layers.
#   port 587 -> ZGRADER_SMTP_USE_TLS=true      (STARTTLS)
#   port 465 -> ZGRADER_SMTP_IMPLICIT_TLS=true (TLS from the first byte)
# Setting USE_TLS on 465 hangs until timeout: there is no plaintext greeting
# to upgrade. The app warns about that pairing at startup.
#
# Verify without registering a throwaway account: Admin -> Settings -> send a
# test email. It reports the actual SMTP result rather than swallowing it.
ZGRADER_SMTP_HOST=mailhog
ZGRADER_SMTP_PORT=1025
ZGRADER_SMTP_USER=
ZGRADER_SMTP_PASSWORD=
ZGRADER_SMTP_FROM=noreply@zgrader.local
ZGRADER_SMTP_USE_TLS=false
ZGRADER_SMTP_IMPLICIT_TLS=false

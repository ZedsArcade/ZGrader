# Copy this file to .env and fill in real values before running
# `docker compose up`. See docs/qa_checklist.md for the full setup walkthrough
# and docs/deployment.md for the Cloudflare Tunnel notes.

# --- Environment ---
# `production` turns on the startup checks that refuse the shipped-default
# secret and database password, and switches off the interactive API docs at
# /api/docs. The backend will not boot in production until the two values
# below are real -- that is deliberate. Use `development` only for local work.
ZGRADER_ENV=production

# --- Postgres ---
POSTGRES_USER=zgrader
# Generate one, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=zgrader
POSTGRES_DATA_PATH=/mnt/user/appdata/zgrader/postgres
REPORTS_DATA_PATH=/mnt/user/appdata/zgrader/reports

# Host-side path the scanner software writes into (SMB/NFS mount point, or a
# local folder). Mounted into both `backend` and `worker` at /data/scans.
# On Unraid this must be writable by uid:gid 99:100 (nobody:users), which is
# what the containers run as -- see backend/Dockerfile's APP_UID/APP_GID.
SCANS_HOST_PATH=/mnt/user/appdata/zgrader/scans

# --- Backend ---
# Generate a real random value: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it later logs everyone out; it signs every session token.
ZGRADER_SECRET_KEY=change-me-to-a-real-random-secret

# Public origin customers reach the site on. Used to build the links inside
# verification and password-reset emails, so a wrong value here produces mail
# with links nobody can open. Include the scheme, no trailing slash.
ZGRADER_SITE_URL=https://cards.example.com

# --- Admin bootstrap (optional) ---
# Set both to auto-create an operator/admin account on startup (the admin
# panel lives at /admin). If an account with this email already exists as a
# client, it is promoted to operator. Leave unset if you already have an
# operator account. Re-deploying only creates/promotes -- it never overwrites
# an existing operator's password.
# ZGRADER_ADMIN_EMAIL=you@example.com
# ZGRADER_ADMIN_PASSWORD=<a strong password>

# --- Optional external AI vision model (off by default) ---
# When enabled, the analysis pipeline also asks an Ollama-compatible vision
# model for extra "AI-assisted" observations. Leave disabled unless you host
# one (e.g. an Ollama container with a llava/qwen2-vl model).
# ZGRADER_AI_ENABLED=false
# ZGRADER_AI_ENDPOINT=http://ollama:11434/api/generate
# ZGRADER_AI_MODEL=llava

# --- SMTP ---
# Account verification and password reset both depend on mail actually being
# delivered, so a real relay is required in production -- with the defaults
# below, nobody can confirm an address or recover a password.
# The defaults point at the bundled `mailhog` dev service
# (docker compose --profile dev up), which catches mail locally with a web UI
# at http://localhost:8025 instead of sending anywhere.
ZGRADER_SMTP_HOST=mailhog
ZGRADER_SMTP_PORT=1025
ZGRADER_SMTP_USER=
ZGRADER_SMTP_PASSWORD=
ZGRADER_SMTP_FROM=noreply@zgrader.local
ZGRADER_SMTP_USE_TLS=false

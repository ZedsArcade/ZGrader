# The Next.js frontend already proxies /api/* to the backend internally
# (see frontend/next.config.ts), so Caddy's only job is being the single
# external entry point in front of it -- no path-based routing needed here.
{
	# Without these a slow client can hold a connection open indefinitely
	# against the single uvicorn worker behind this. write is generous
	# because report PDFs are generated on demand.
	servers {
		timeouts {
			read_body 60s
			read_header 10s
			write 120s
			idle 120s
		}
	}
}

# Homelab default: plain HTTP on port 80, LAN-only.
#
# To get real automatic HTTPS via Let's Encrypt instead, replace ":80" below
# with your actual domain name (e.g. "cards.example.com"). Caddy handles
# certificate issuance/renewal automatically, as long as ports 80 and 443
# are reachable from the internet for the ACME challenge.
#
# Behind a Cloudflare Tunnel, leave this as ":80" and point `cloudflared` at
# it: TLS terminates at Cloudflare and the origin is never directly
# reachable. That last part is load-bearing -- the backend trusts
# CF-Connecting-IP for rate limiting, which is only safe while nothing can
# reach the origin without going through the tunnel.
#
# docker-compose.yml now publishes Caddy on 127.0.0.1 only, so that holds by
# construction rather than by convention, and
# backend/tests/test_compose_port_bindings.py fails if it reverts. It was
# "8080:80" -- reachable from the whole LAN -- for as long as this warning
# sat here unread, because the compose service overrode the command and this
# file was never loaded at all. See docs/deployment.md.
:80 {
	# Comfortably above the largest scan the API accepts and well below
	# anything that would tie up a worker. Oversized requests are rejected
	# here rather than being read to completion by the app.
	request_body {
		max_size 25MB
	}

	log {
		output stdout
		format json
	}

	reverse_proxy frontend:3000
}
